# Normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.tsx text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.env* text eol=lf
*.gitignore text eol=lf
*.prettierrc text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
