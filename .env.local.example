# SMTP credentials used to send career applications (see src/lib/mailer.ts).
# Works with any SMTP provider — Gmail Workspace, Outlook/Microsoft 365, Zoho, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Optional: defaults to SMTP_USER if not set
SMTP_FROM=careers@namigroup.in

# Where career applications are sent. Defaults to ib@namigroup.in if not set.
CAREERS_EMAIL_TO=ib@namigroup.in
